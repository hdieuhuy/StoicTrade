# Copy to .env.local and fill in values locally.
# Server-only: never add NEXT_PUBLIC_ to database connection variables.
DATABASE_URL="postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
# Optional when accessing Postgres from serverless/IPv4 environments.
DATABASE_POOLER_URL=""

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"
SUPABASE_PROJECT_REF="YOUR_PROJECT_REF"
SUPABASE_STORAGE_BUCKET="trade-attachments"
